Bootstrap: docker
From: python:3.11.9-slim

# ──────────────────────────────────────────────────────────────────────────
# GLMap analysis container (core, torch-free).
#
# Packages the *analysis* environment only: Python 3.11.9 + the pinned
# analysis stack from pyproject.toml + the importable `glmap` package. This
# is everything needed to USE the precomputed 123-model results (PLL /
# log-likelihood responses over the 10,000-probe panel, V/Vd/D matrices,
# audit metadata) and to reproduce every figure/table. No GPU, no torch.
#
# It does NOT contain model weights or the per-family scoring environments —
# those are 9 separate, conflicting micromamba envs; see models/env_routing.md
# and keep using micromamba for re-scoring.
#
# The image carries only the env; your GLMap checkout (with data/ + results/)
# is bind-mounted at run time, so the image stays small and works with any
# checkout.
#
# Build (run from the repository root, where pyproject.toml + glmap/ live):
#     apptainer build glmap-analysis.sif container/analysis.def
#
# Run — bind-mount your checkout at /work and treat it as the working dir:
#     apptainer run --bind "$PWD":/work --pwd /work glmap-analysis.sif \
#         -c "import glmap; print(len(glmap.load_audit()), 'models')"
#     # or an interactive shell:
#     apptainer shell --bind "$PWD":/work --pwd /work glmap-analysis.sif
#     # or run a figure script:
#     apptainer run --bind "$PWD":/work --pwd /work glmap-analysis.sif \
#         scripts/figures/fig3a_model_map_family.py
# ──────────────────────────────────────────────────────────────────────────

%files
    pyproject.toml /opt/glmap/pyproject.toml
    glmap          /opt/glmap/glmap

%post
    set -eu
    # git is occasionally needed by pip for VCS metadata / wheels.
    apt-get update
    apt-get install -y --no-install-recommends git
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip
    # Installs glmap + the version-pinned analysis dependencies declared in
    # pyproject.toml (numpy, pandas, pyarrow, scipy, scikit-learn, matplotlib,
    # seaborn, umap-learn, PyYAML, huggingface_hub). No torch / transformers.
    cd /opt/glmap
    python -m pip install --no-cache-dir .

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Keep figure generation headless inside the container.
    export MPLBACKEND=Agg

%runscript
    # `apptainer run ... <args>` is forwarded straight to python, so you can
    # pass either `-c "..."` or a script path under the bind-mounted checkout.
    exec python "$@"

%test
    # Sanity check baked into `apptainer test glmap-analysis.sif`.
    # NB: heredoc body must stay flush-left so python gets unindented code.
    python - <<'PY'
import glmap
print("glmap import OK — torch-free analysis env")
import numpy, pandas, sklearn, umap, matplotlib   # noqa: F401
print("analysis stack import OK")
PY

%labels
    Maintainer  ai4nucleome
    Project     GLMap
    Component   analysis-core
    Python      3.11.9
    Torch       none (analysis only; see models/env_routing.md for scoring)

%help
    GLMap analysis container — Python 3.11.9 + the pinned, torch-free analysis
    stack + the importable `glmap` package. Use it to work with the precomputed
    123-model results and reproduce the figures/tables.

    Bind-mount your GLMap checkout (which holds data/ and results/) at /work:

        apptainer run --bind "$PWD":/work --pwd /work glmap-analysis.sif \
            -c "import glmap; print(glmap.load_matrix('V_AR').shape)"

    For re-scoring models (torch + per-family envs) this image is NOT the right
    tool — see models/README.md and models/env_routing.md.
