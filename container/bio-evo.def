Bootstrap: localimage
From: base-cu128.sif

# ──────────────────────────────────────────────────────────────────────────
# GLMap scoring image — evo group (cu124).
#
#   evo1   Python 3.11  torch 2.7.1   evo-model, flash-attn 2.7.4
#   evo2   Python 3.12  torch 2.7.1   evo2,      flash-attn 2.8.0
#
# This group is built by re-creating the envs with pip (torch + flash-attn
# from the local wheelhouse, the rest from PyPI/Tsinghua) rather than by
# conda-pack — it is the original recipe that produced bio-evo.sif. The other
# groups (cu118/cu121/default) instead ship conda-pack / plain tarballs of the
# already-working host envs; see README.md.
#
# Build (from container/, on HPC `module load apptainer-1.4.5`):
#     apptainer build --fakeroot bio-evo.sif bio-evo.def
# Run:
#     GLMAP_ENV=evo2 apptainer run --nv --bind "$PWD":/work --pwd /work \
#         bio-evo.sif scripts/score/scoring_worker.py --from-audit --hf-ids ...
#
# NB: the %post below used a 127.0.0.1:7890 tunnel for PyPI when bio-evo.sif
# was first built; if that tunnel is down, drop the proxy exports and rely on
# the Tsinghua index + the local wheelhouse.
# ──────────────────────────────────────────────────────────────────────────

%files
    wheels/flash_attn-2.7.4.post1+cu12torch2.7cxx11abiTRUE-cp311-cp311-linux_x86_64.whl /opt/wheels/
    wheels/flash_attn-2.8.0.post2+cu12torch2.7cxx11abiTRUE-cp311-cp311-linux_x86_64.whl /opt/wheels/

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/micromamba/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    export HF_HOME=/workspace/.cache/huggingface
    export TRANSFORMERS_CACHE=/workspace/.cache/huggingface
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0+PTX"
    export CC=/usr/bin/gcc-11
    export CXX=/usr/bin/g++-11
    export CUDAHOSTCXX=/usr/bin/g++-11

%post
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    WHEELHOUSE=/opt/wheels

    cat > /root/.mambarc << 'MAMBARC'
channels:
  - https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge/
  - https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main/
channel_priority: strict
ssl_verify: false
MAMBARC

    # Proxy used when bio-evo.sif was first built; drop these if the tunnel
    # is down (Tsinghua index + the wheelhouse cover most of it).
    export http_proxy=http://127.0.0.1:7890  https_proxy=http://127.0.0.1:7890
    export HTTP_PROXY=http://127.0.0.1:7890  HTTPS_PROXY=http://127.0.0.1:7890

    /opt/micromamba/bin/micromamba create -y -n evo1 python=3.11 pip setuptools wheel ninja
    /opt/micromamba/bin/micromamba create -y -n evo2 python=3.11 pip setuptools wheel ninja
    /opt/micromamba/bin/micromamba clean --all --yes

    /opt/micromamba/bin/micromamba run -n evo1 pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    /opt/micromamba/bin/micromamba run -n evo2 pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

    # torch from the local wheelhouse (large, CUDA-specific).
    /opt/micromamba/bin/micromamba run -n evo1 pip install --no-index --find-links="$WHEELHOUSE" \
        torch==2.7.1 torchvision torchaudio
    /opt/micromamba/bin/micromamba run -n evo2 pip install --no-index --find-links="$WHEELHOUSE" \
        torch==2.7.1 torchvision torchaudio

    # flash-attention from the local wheel files.
    /opt/micromamba/bin/micromamba run -n evo1 pip install --no-build-isolation \
        "$WHEELHOUSE/flash_attn-2.7.4.post1+cu12torch2.7cxx11abiTRUE-cp311-cp311-linux_x86_64.whl"
    /opt/micromamba/bin/micromamba run -n evo2 pip install --no-build-isolation \
        "$WHEELHOUSE/flash_attn-2.8.0.post2+cu12torch2.7cxx11abiTRUE-cp311-cp311-linux_x86_64.whl"

    # the rest: wheelhouse first, fall back to the (Tsinghua) index.
    /opt/micromamba/bin/micromamba run -n evo1 pip install --find-links="$WHEELHOUSE" \
        evo-model packaging psutil \
        transformers huggingface_hub safetensors sentencepiece einops \
        biopython bcbio-gff tqdm six scipy scikit-learn pandas matplotlib

    /opt/micromamba/bin/micromamba run -n evo2 pip install --find-links="$WHEELHOUSE" \
        evo2 packaging psutil \
        transformers huggingface_hub safetensors sentencepiece einops \
        biopython bcbio-gff tqdm six scipy scikit-learn pandas matplotlib

    mkdir -p /workspace/.cache/huggingface

%runscript
    # GLMAP_ENV ∈ {evo1, evo2}; EVO_ENV kept for the originally-built image.
    ENV_NAME="${GLMAP_ENV:-${EVO_ENV:-evo2}}"
    exec /opt/micromamba/bin/micromamba run -n "$ENV_NAME" python "$@"

%labels
    Project   GLMap
    Component scoring-evo-cu124
    Envs      evo1,evo2

%help
    GLMap evo scoring image (evo1 / evo2, cu124). Select the env with
    GLMAP_ENV; bind your GLMap checkout for data / weights.
