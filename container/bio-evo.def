Bootstrap: localimage
From: base-cu128.sif

# ──────────────────────────────────────────────────────────────────────────
# GLMap scoring image — evo group (cu124).
#
#   evo    Python 3.11  torch 2.6.0+cu124   evo-model  (evo-1 / evo-1.5 models)
#   evo2   Python 3.12  torch 2.6.0+cu124   evo2       (evo2 7b models)
#
# Both envs are shipped as PLAIN directory tarballs of the working host envs
# (`tar czf evo.tar.gz evo`), not conda-pack: the host evo/evo2 envs each have
# ~20 packages installed by BOTH conda and pip (numpy, triton, …) with
# mismatched versions, which makes conda-pack frankenstein them. A plain tar
# copies the on-disk files exactly (the versions that actually work), so the
# container env is a faithful copy of the host env — including pyarrow and
# everything the GLMap scoring worker needs.
#
# NB: evo2_1b_base needs transformer_engine (FP8), which is NOT installed on
# the host either — score evo2 with the 7b models (evo2_7b / evo2_7b_base).
#
# Build (from container/, on HPC `module load apptainer-1.4.5`):
#     apptainer build --fakeroot bio-evo.sif bio-evo.def
# Run:
#     GLMAP_ENV=evo2 apptainer run --nv --bind "$PWD":/work --pwd /work \
#         bio-evo.sif scripts/score/scoring_worker.py --from-audit --hf-ids arcinstitute/evo2_7b_base
# ──────────────────────────────────────────────────────────────────────────

%files
    packed/evo.tar.gz   /opt/packed/evo.tar.gz
    packed/evo2.tar.gz  /opt/packed/evo2.tar.gz

%post
    set -eu
    mkdir -p /opt/micromamba/envs /workspace
    for e in evo evo2; do
        echo ">>> unpacking env: $e (plain tar; top-level $e/)"
        # Plain tar carries a top-level <env>/ dir → extract into envs/.
        # python relocates by its own location, so no conda-unpack is needed.
        tar xzf "/opt/packed/$e.tar.gz" -C /opt/micromamba/envs
        rm -f "/opt/packed/$e.tar.gz"
    done

%environment
    export LC_ALL=C
    export LANG=C
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    export MPLBACKEND=Agg
    export HF_HOME=/workspace/.cache/huggingface

%runscript
    # Dispatch to the right family env: GLMAP_ENV ∈ {evo, evo2}.
    ENV_NAME="${GLMAP_ENV:-evo2}"
    ENV_PREFIX="/opt/micromamba/envs/${ENV_NAME}"
    if [ ! -x "${ENV_PREFIX}/bin/python" ]; then
        echo "unknown GLMAP_ENV=${ENV_NAME} (have: evo evo2)" >&2
        exit 2
    fi
    # evo2 needs its own lib + torch lib on LD_LIBRARY_PATH (per env_routing.md).
    TORCH_LIB="$(echo ${ENV_PREFIX}/lib/python*/site-packages/torch/lib)"
    export LD_LIBRARY_PATH="${ENV_PREFIX}/lib:${TORCH_LIB}:${LD_LIBRARY_PATH:-}"
    exec "${ENV_PREFIX}/bin/python" "$@"

%labels
    Project   GLMap
    Component scoring-evo-cu124
    Envs      evo,evo2

%help
    GLMap evo scoring image (evo / evo2, cu124), plain-tar copies of the host
    envs. Select the env with GLMAP_ENV (default evo2); bind your GLMap
    checkout for data / weights. Use the 7b evo2 models (1b needs FP8 TE).
