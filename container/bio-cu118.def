Bootstrap: localimage
From: base-cu128.sif

# ──────────────────────────────────────────────────────────────────────────
# GLMap scoring image — cu118 family group.
#
#   caduceus    Python 3.8  torch 2.2.0+cu118   mamba-ssm 1.2, flash-attn 2.5.6   (conda-pack)
#   gf          Python 3.10 torch 2.1.1+cu118   evo-model, flash-attn 2.7.2       (conda-pack)
#   hyena-dna   Python 3.9  torch 2.7.1+cu118   transformers + einops             (plain tar)
#
# caduceus / gf ship as conda-pack tarballs of the working host envs (so the
# painful flash-attn / mamba-ssm builds are shipped, not recompiled).
# hyena-dna's host env is polluted (two python versions, three torch installs,
# 14 GB) so we ship a freshly-built CLEAN env instead, as a plain directory
# tarball: glmap's HyenaDNA loader needs only torch + transformers + einops
# (the standalone_hyenadna model code comes from the bind-mounted checkout,
# flash-attn is unused at scoring time), so the clean env is ~4 GB and faithful.
# Every env is shipped pre-built — no pip / network at build time.
#
# Build (from container/, on HPC `module load apptainer-1.4.5`):
#     apptainer build --fakeroot bio-cu118.sif bio-cu118.def
# Run (pick the env per model family; --nv for GPU, bind the checkout):
#     GLMAP_ENV=caduceus apptainer run --nv --bind "$PWD":/work --pwd /work \
#         bio-cu118.sif scripts/score/scoring_worker.py --from-audit --hf-ids ...
# ──────────────────────────────────────────────────────────────────────────

%files
    packed/caduceus.tar.gz   /opt/packed/caduceus.tar.gz
    packed/gf.tar.gz         /opt/packed/gf.tar.gz
    packed/hyena-dna.tar.gz  /opt/packed/hyena-dna.tar.gz

%post
    set -eu
    mkdir -p /opt/micromamba/envs /workspace

    # conda-pack envs: contents are top-level (bin/, lib/, ...) -> extract into
    # envs/<name>/, then conda-unpack rewrites the build-time prefix.
    for e in caduceus gf; do
        echo ">>> unpacking conda-pack env: $e"
        mkdir -p "/opt/micromamba/envs/$e"
        tar xzf "/opt/packed/$e.tar.gz" -C "/opt/micromamba/envs/$e"
        "/opt/micromamba/envs/$e/bin/python" "/opt/micromamba/envs/$e/bin/conda-unpack" || true
        rm -f "/opt/packed/$e.tar.gz"
    done

    # plain-tar envs (clean rebuild): a top-level <name>/ dir -> extract into
    # envs/. python relocates by its own location, so no conda-unpack needed.
    for e in hyena-dna; do
        echo ">>> unpacking plain-tar env: $e"
        tar xzf "/opt/packed/$e.tar.gz" -C /opt/micromamba/envs
        rm -f "/opt/packed/$e.tar.gz"
    done

%environment
    export LC_ALL=C
    export LANG=C
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    export MPLBACKEND=Agg
    export HF_HOME=/workspace/.cache/huggingface

%runscript
    # Dispatch to the right family env: GLMAP_ENV ∈ {caduceus, gf, hyena-dna}.
    ENV_NAME="${GLMAP_ENV:?set GLMAP_ENV to one of: caduceus gf hyena-dna}"
    ENV_PREFIX="/opt/micromamba/envs/${ENV_NAME}"
    if [ ! -x "${ENV_PREFIX}/bin/python" ]; then
        echo "unknown GLMAP_ENV=${ENV_NAME} (have: caduceus gf hyena-dna)" >&2
        exit 2
    fi
    # Some envs need their own lib + torch lib on LD_LIBRARY_PATH.
    TORCH_LIB="$(echo ${ENV_PREFIX}/lib/python*/site-packages/torch/lib)"
    export LD_LIBRARY_PATH="${ENV_PREFIX}/lib:${TORCH_LIB}:${LD_LIBRARY_PATH:-}"
    exec "${ENV_PREFIX}/bin/python" "$@"

%labels
    Project   GLMap
    Component scoring-cu118
    Envs      caduceus,gf,hyena-dna

%help
    GLMap cu118 scoring image (caduceus / gf / hyena-dna). Select the env with
    GLMAP_ENV and run python inside it; bind your GLMap checkout for data /
    weights. Map model family -> env via ../../models/env_routing.md.
